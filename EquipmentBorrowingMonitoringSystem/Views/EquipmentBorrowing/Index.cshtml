@model IEnumerable<EquipmentBorrowingMonitoringSystem.Models.EquipmentBorrowing>

@{
    ViewData["Title"] = "Equipment Monitoring";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Equipment Borrowing Monitoring</h2>
        <a asp-action="Create" class="btn btn-primary">
            Register Borrowing
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search transaction, borrower, or equipment..." />

            <button type="submit" class="btn btn-outline-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </form>

    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Transaction No.</th>
                            <th>Borrower</th>
                            <th>Equipment</th>
                            <th>Quantity</th>
                            <th>Borrow Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.TransactionNumber</td>
                                    <td>@item.BorrowerName</td>
                                    <td>@item.EquipmentName</td>
                                    <td>@item.Quantity</td>
                                    <td>
                                        @item.BorrowDateTime.ToString("MMM dd, yyyy hh:mm tt")
                                    </td>
                                    <td>
                                        @item.ExpectedReturnDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (item.Status == "Borrowed")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Borrowed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Returned
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            @if (item.Status == "Borrowed")
                                            {
                                                <a asp-action="Return"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-success">
                                                    Return
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center py-4">
                                    No borrowing records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>