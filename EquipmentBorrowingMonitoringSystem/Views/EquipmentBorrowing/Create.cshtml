@model EquipmentBorrowingMonitoringSystem.Models.EquipmentBorrowing

@{
    ViewData["Title"] = "Register Borrowing";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow">
                <div class="card-body">

                    <h2 class="mb-4">Register Equipment Borrowing</h2>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="TransactionNumber"
                                       class="form-label">
                                </label>

                                <input asp-for="TransactionNumber"
                                       class="form-control" />

                                <span asp-validation-for="TransactionNumber"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BorrowerName"
                                       class="form-label">
                                </label>

                                <input asp-for="BorrowerName"
                                       class="form-control" />

                                <span asp-validation-for="BorrowerName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BorrowerType"
                                       class="form-label">
                                </label>

                                <select asp-for="BorrowerType"
                                        class="form-select">
                                    <option value="">Select borrower type</option>
                                    <option value="Student">Student</option>
                                    <option value="Faculty">Faculty</option>
                                    <option value="Staff">Staff</option>
                                </select>

                                <span asp-validation-for="BorrowerType"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BorrowerId"
                                       class="form-label">
                                </label>

                                <input asp-for="BorrowerId"
                                       class="form-control" />

                                <span asp-validation-for="BorrowerId"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DepartmentOrCourse"
                                       class="form-label">
                                </label>

                                <input asp-for="DepartmentOrCourse"
                                       class="form-control" />

                                <span asp-validation-for="DepartmentOrCourse"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EquipmentName"
                                       class="form-label">
                                </label>

                                <input asp-for="EquipmentName"
                                       class="form-control" />

                                <span asp-validation-for="EquipmentName"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EquipmentCategory"
                                       class="form-label">
                                </label>

                                <select asp-for="EquipmentCategory"
                                        class="form-select">
                                    <option value="">Select category</option>
                                    <option value="Computer">Computer</option>
                                    <option value="Laptop">Laptop</option>
                                    <option value="Projector">Projector</option>
                                    <option value="Peripheral">Peripheral</option>
                                    <option value="Other">Other</option>
                                </select>

                                <span asp-validation-for="EquipmentCategory"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity"
                                       class="form-label">
                                </label>

                                <input asp-for="Quantity"
                                       class="form-control"
                                       min="1" />

                                <span asp-validation-for="Quantity"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BorrowDateTime"
                                       class="form-label">
                                </label>

                                <input asp-for="BorrowDateTime"
                                       class="form-control"
                                       type="datetime-local" />

                                <span asp-validation-for="BorrowDateTime"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ExpectedReturnDate"
                                       class="form-label">
                                </label>

                                <input asp-for="ExpectedReturnDate"
                                       class="form-control"
                                       type="date" />

                                <span asp-validation-for="ExpectedReturnDate"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Purpose"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Purpose"
                                          class="form-control"
                                          rows="3">
                                </textarea>

                                <span asp-validation-for="Purpose"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Notes"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="3">
                                </textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Register Borrowing
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}